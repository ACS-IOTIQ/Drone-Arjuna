# Copy this file to .env and fill in values before running docker-compose

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_DB=dronearjuna
POSTGRES_USER=da_admin
POSTGRES_PASSWORD=  # REQUIRED: generate a unique value (e.g. python -c "import secrets;print(secrets.token_urlsafe(24))")

# ── TimescaleDB ─────────────────────────────────────────────────────
TIMESCALE_DB=da_telemetry

# pgAdmin web database UI
PGADMIN_DEFAULT_EMAIL=admin@dronearjuna.com
PGADMIN_DEFAULT_PASSWORD=  # REQUIRED: generate a unique value (e.g. python -c "import secrets;print(secrets.token_urlsafe(24))")

# ── Redis ───────────────────────────────────────────────────────────
REDIS_PASSWORD=  # REQUIRED: generate a unique value (e.g. python -c "import secrets;print(secrets.token_urlsafe(24))")

# ── RabbitMQ ────────────────────────────────────────────────────────
RABBITMQ_USER=da_mq
RABBITMQ_PASSWORD=  # REQUIRED: generate a unique value (e.g. python -c "import secrets;print(secrets.token_urlsafe(24))")

# ── MinIO ───────────────────────────────────────────────────────────
MINIO_USER=da_minio
MINIO_PASSWORD=  # REQUIRED: generate a unique value (e.g. python -c "import secrets;print(secrets.token_urlsafe(24))")

# ── Elasticsearch ────────────────────────────────────────────────────
# Inside Docker Compose use the service name; outside use localhost:9200
ELASTICSEARCH_URL=http://elasticsearch:9200

# ── App secrets ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=  # REQUIRED, >=32 bytes; startup fails on placeholders
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────
# NOTE: field name must be ALLOWED_ORIGINS_STR (pydantic-settings key).
# Comma-separated, no spaces, no brackets.
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:5173

# ── MAVLink SITL (for development without a real drone) ──────────────
SITL_HOST=host.docker.internal
SITL_PORT=14550
HF_FEED_HOST=0.0.0.0
HF_FEED_PORT=10110

# ── Database backup / auto-restore ────────────────────────────────────
# Dumps every table to backend/backups/ on a timer; if a table that had
# data in the last dump is later found empty, it's restored automatically.
BACKUP_INTERVAL_MINUTES=60
BACKUP_RETENTION_COUNT=24
INTEGRITY_CHECK_INTERVAL_MINUTES=15

# ── SMTP / Email ─────────────────────────────────────────────────────
# Dev default: MailHog (http://localhost:8025 to read emails)
# Set SMTP_ENABLED=true to activate; leave false to skip email sending.
SMTP_ENABLED=false
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DroneArjuna GCS <noreply@dronearjuna.local>

# Production Gmail example (uncomment and fill in):
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=DroneArjuna GCS <your-account@gmail.com>

# ── Elasticsearch auth (security is enabled) ─────────────────────────
ELASTIC_PASSWORD=  # REQUIRED

# ── Hardening switches ───────────────────────────────────────────────
ENABLE_API_DOCS=false
TRUST_PROXY_HEADERS=false          # true only behind a trusted reverse proxy
CAMERA_ALLOWED_HOSTS_STR=          # comma-separated private camera hosts permitted for payload streams
RADIO_BIND_ADDR=127.0.0.1          # set to the radio/bridge interface IP for MAVLink/NMEA UDP; use the PC's WiFi/LAN IP (or 0.0.0.0 on a trusted network + firewall) to accept MAVLink UDP 14550-14552 from WiFi/4G/companion-computer links
# BOOTSTRAP_ADMIN_PASSWORD=        # optional; otherwise a random one-time password is printed once

# MAVLink 2 signing key shared with the autopilots (64 hex chars). Empty = signing off.
#   python -c "import secrets;print(secrets.token_hex(32))"
MAVLINK_SIGNING_KEY=

# Background auto-connect over USB (COM bridge / serial). Default false: a USB device
# connects only when the operator clicks Connect. true = connect on cable plug-in and
# retry every 15 s (this holds the bridge's single client slot, blocking a manual Connect).
AUTOCONNECT_USB=false

# Production overlay (docker-compose.prod.yml)
# PUBLIC_ORIGIN=https://gcs.example.mil
# PUBLIC_BIND_ADDR=0.0.0.0

# ── Backup integrity ─────────────────────────────────────────────────
# Dumps are always HMAC-signed (key derived from SECRET_KEY). A dump that fails
# verification is never restored.
# BACKUP_REQUIRE_SIGNATURE=true      # also reject unsigned pre-upgrade dumps (set once they have rotated out)
# BACKUP_ENCRYPTION_KEY=             # optional encryption at rest; python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#                                    # keep this key OUTSIDE the backup volume/bucket — losing it makes encrypted dumps unreadable
# BACKUP_AUTO_RESTORE=false          # report data loss but restore only after an admin confirms (POST /api/system/backup/restore)

# ── Vessel NMEA feed (UDP :10110) ────────────────────────────────────
# NMEA has no authentication. Restrict who may send, and implausible jumps are rejected.
# HF_FEED_ALLOWED_SOURCES_STR=192.168.10.5,10.20.0.0/24
# HF_FEED_MAX_SPEED_MS=40
# HF_FEED_MAX_MSGS_PER_SEC=20
